{
  "name": "@deephaus/mcp-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "deephaus-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "dev": "tsx watch src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@deephaus/api-client": "workspace:*",
    "@deephaus/mcp-core": "workspace:*",
    "@deephaus/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
