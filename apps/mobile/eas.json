    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "staging-testflight": {
      "ios": {
        "ascAppId": "6812905977",
        "appleTeamId": "NVNN9G49JA",
        "bundleIdentifier": "com.deephaus.app.staging"
      }
    },
    "production": {}
  },
  "cli": {
    "appVersionSource": "local"
  }
}
