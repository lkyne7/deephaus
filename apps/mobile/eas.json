{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "staging-testflight": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "ios": {
        "scheme": "DeepHaus Staging",
        "buildConfiguration": "Release Staging"
