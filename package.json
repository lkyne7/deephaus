{
  "name": "deephaus",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm dev:web",
    "dev:web": "node scripts/environments/dev.mjs web",
    "dev:web:clean": "node scripts/environments/dev.mjs web-clean",
    "dev:mobile": "node scripts/environments/dev.mjs mobile",
    "dev:mcp": "pnpm --filter @deephaus/mcp-server dev",
    "mobile:ios": "node scripts/environments/dev.mjs ios-open",
    "mobile:android": "pnpm --filter @deephaus/mobile android",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "supabase:login": "npx supabase login",
    "supabase:link": "npx supabase link --project-ref rdfijwmxlyvykcnxfurd",
    "supabase:push": "node scripts/environments/database.mjs",
    "supabase:status": "npx supabase migration list --linked",
    "supabase:check": "cd apps/web && pnpm dlx tsx .imgtest/check-schema.mts",
    "supabase:auth": "bash scripts/supabase/auth.sh",
    "vercel:env:pull": "npx vercel env pull .env.vercel.production --environment=production --yes",
    "vercel:prod": "npx vercel --prod --yes",
    "test:launch": "node --test tests/launch/*.test.mjs && vitest run --config vitest.launch.config.ts",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "launch:seed": "node scripts/launch/seed.mjs",
    "launch:web": "node scripts/launch/run.mjs web",
    "launch:start": "node scripts/launch/run.mjs start",
    "launch:test": "node scripts/launch/run.mjs test",
    "launch:build": "node scripts/launch/run.mjs build",
    "launch:deletion-check": "node scripts/launch/deletion-check.mjs",
    "launch:mobile": "node scripts/launch/native.mjs metro",
    "launch:ios:build": "node scripts/launch/native.mjs build",
    "launch:ios:build-release": "node scripts/launch/native.mjs build-release",
    "launch:ios:open": "node scripts/launch/native.mjs open",
    "launch:ios:open-release": "node scripts/launch/native.mjs open-release",
    "launch:seed-native": "node scripts/launch/seed.mjs --native",
    "launch:maestro": "node scripts/launch/maestro.mjs",
    "launch:prepare-migrations": "node scripts/launch/prepare-migrations.mjs",
    "launch:native-recovery": "node scripts/launch/native-recovery.mjs",
    "launch:powersync-check": "node scripts/launch/powersync-check.mjs",
    "launch:seed-media": "node scripts/launch/seed-media.mjs",
    "launch:native-download": "node scripts/launch/maestro.mjs download",
    "launch:native-storage-check": "node scripts/launch/native-storage-check.mjs",
    "launch:native-draft-restart": "node scripts/launch/native-draft-restart.mjs",
    "launch:native-account-switch": "node scripts/launch/native-account-switch.mjs",
    "launch:native-media-upgrade": "node scripts/launch/native-media-upgrade.mjs",
    "launch:native-accessibility": "node scripts/launch/native-accessibility.mjs",
    "dev:anki": "node scripts/environments/dev.mjs anki",
    "dev:extraction": "node scripts/environments/dev.mjs extraction"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "fake-indexeddb": "6.2.5",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.3",
      "@supabase/supabase-js": "2.106.2"
    }
  }
}
