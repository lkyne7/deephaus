# Supabase (create a project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM — required for real flashcard generation from text/PDF
OPENAI_API_KEY=sk-...
# Set to false once OPENAI_API_KEY is configured
DEEPHAUS_USE_MOCK_LLM=true

# Hybrid PDF extraction rollout. Both flags must be true for the web client to
# use direct-to-storage uploads. The worker also needs MISTRAL_API_KEY and the
# same EXTRACTION_WORKER_SECRET as the web deployment.
PDF_EXTRACTION_V2=false
NEXT_PUBLIC_PDF_EXTRACTION_V2=false
EXTRACTION_WORKER_SECRET=
MISTRAL_API_KEY=
APP_BASE_URL=http://localhost:3000

# Notion integration — register a public connection at
# https://www.notion.so/profile/integrations with redirect URIs:
#   Local:      http://localhost:3000/api/notion/callback
#   Production: https://www.deephaus.ai/api/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional per-environment override (Vercel production sets this automatically).
# Local dev: http://localhost:3000/api/notion/callback
NOTION_REDIRECT_URI=

# Canonical public URL (production: https://www.deephaus.ai)
# NEXT_PUBLIC_APP_URL=

# DeepHaus MCP server (apps/mcp-server — used with Claude Desktop / ChatGPT Connectors)
# DEEPHAUS_API_URL=http://localhost:3000
# DEEPHAUS_API_TOKEN=dh_...
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
