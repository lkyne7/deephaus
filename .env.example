# Supabase (create a project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM — required for real flashcard generation from text/PDF
OPENAI_API_KEY=sk-...
# Set to false once OPENAI_API_KEY is configured
DEEPHAUS_USE_MOCK_LLM=true

# Notion integration — register a public connection at
# https://www.notion.so/profile/integrations with redirect URI
# {APP_ORIGIN}/api/notion/callback (e.g. http://localhost:3000/api/notion/callback)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional: override the redirect URI (defaults to {origin}/api/notion/callback)
NOTION_REDIRECT_URI=

# DeepHaus MCP server (apps/mcp-server — used with Claude Desktop / ChatGPT Connectors)
# DEEPHAUS_API_URL=http://localhost:3000
# DEEPHAUS_API_TOKEN=dh_...
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
